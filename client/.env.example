# Copy these into Vercel → Project → Settings → Environment Variables
# (or into client/.env for local testing — .env is git-ignored).

# EmailJS (sends each booking to ritu.tourist.taxi@gmail.com) — see README.md
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# OPTIONAL: also keep a backup copy on the Render server. Leave empty to store nothing.
# Example: https://ritutourist.onrender.com
VITE_API_URL=

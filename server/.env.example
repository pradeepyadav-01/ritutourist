# Set these in Render → your service → Environment (never commit real values).

# Secret that protects GET /api/bookings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Websites allowed to call this API, comma separated, NO trailing slash.
ALLOWED_ORIGINS=https://ritutourist.vercel.app
